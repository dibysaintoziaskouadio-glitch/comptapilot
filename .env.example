# Variables de docker-compose.yml (copier en .env, jamais commité).

# Mot de passe de la base PostgreSQL du conteneur.
POSTGRES_PASSWORD=changer-moi

# Secret de signature des sessions, 32 caractères minimum : openssl rand -base64 48
JWT_SECRET=changer-moi-avec-openssl-rand-base64-48

# Port publié sur l'hôte et URL publique de l'interface.
COMPTA_PORT=8090
PUBLIC_URL=http://localhost:8090

# true derrière HTTPS (cookie de session « Secure »).
COOKIE_SECURE=false

# false pour fermer l'inscription libre après création des comptes.
ALLOW_REGISTRATION=true

# --- Codes de vérification (inscription par e-mail + téléphone, mot de passe oublié) ---
# Démonstration sans fournisseur : le code s'affiche à l'écran. À laisser à false en production.
CODES_VISIBLES=false

# E-mail par SMTP (Brevo, Gmail avec mot de passe d'application, OVH, Mailjet…)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_EXPEDITEUR=Comptapilot <no-reply@votre-domaine.com>

# SMS et WhatsApp par Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
